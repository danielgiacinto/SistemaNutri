# Copiá este archivo como .env.local y completá los valores. Nunca subas .env.local al repositorio.
# Detalle de cada variable en docs/despliegue.md.

# --- Públicas (se incluyen en el navegador) ---------------------------------
# Supabase > Project Settings > API (o la salida de `npm run bd:iniciar` en local).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clave publicable (sb_publishable_...) o, en proyectos antiguos, la clave "anon".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL pública del sitio. En producción: https://tu-dominio. En previews de Vercel dejala vacía.
NEXT_PUBLIC_SITIO_URL=http://localhost:3000

# --- Privadas (solo servidor / scripts) --------------------------------------
# Clave secreta (sb_secret_...) o "service_role". Omite RLS.
# La necesita el webhook de Mercado Pago para registrar cobros verificados.
SUPABASE_SECRET_KEY=

# --- Mercado Pago (servidor). No uses el prefijo NEXT_PUBLIC_ en el token ni en el secreto. ---
# Credenciales de prueba durante el desarrollo. En producción, las de la aplicación productiva.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRETO=
# Clave pública del formulario de tarjeta. Sí puede ir al navegador.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Solo en prueba: correo de otra cuenta de prueba de Mercado Pago (el comprador).
# El access token es el vendedor. No uses tu correo real ni el del mismo vendedor.
MERCADOPAGO_CORREO_PAGADOR_PRUEBA=

# --- Supabase CLI local: credenciales de Google OAuth (ver docs/autenticacion.md) ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
