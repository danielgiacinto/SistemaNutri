# Copiá este archivo como .env.local y completá los valores. Nunca subas .env.local al repositorio.
# Detalle de cada variable en docs/despliegue.md.

# --- Públicas (se incluyen en el navegador) ---------------------------------
# Supabase > Project Settings > API (o la salida de `npm run bd:iniciar` en local).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clave publicable (sb_publishable_...) o, en proyectos antiguos, la clave "anon".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL pública del sitio. En producción: https://tu-dominio. En previews de Vercel dejala vacía.
NEXT_PUBLIC_SITIO_URL=https://nutrisfera.vercel.app/
# Opcional: conservada para coincidir con .env.local. El checkout alojado actual no la usa.
# Si la completás, corresponde a la misma aplicación del vendedor que el Access Token.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# --- Privadas (solo servidor / scripts) --------------------------------------
# Clave secreta (sb_secret_...) o "service_role". Omite RLS.
# La necesita el webhook de Mercado Pago para registrar cobros verificados.
SUPABASE_SECRET_KEY=

# --- Mercado Pago (servidor). No uses el prefijo NEXT_PUBLIC_ en el token ni en el secreto. ---
# Suscripciones: en desarrollo se usa el Access Token APP_USR de una aplicación
# creada dentro de la cuenta VENDEDORA DE PRUEBA. No es el token de tu cuenta real.
# El checkout usa mercadopago.com.ar también para pruebas; no se reemplaza por otro dominio.
# En Vercel de pruebas se conservan el vendedor y el comprador ficticios.
# Solo al habilitar cobros reales: token del vendedor real y quitar el correo de prueba.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRETO=
# El checkout se abre en Mercado Pago. No se necesita una clave pública ni un SDK en el navegador.
# Solo en prueba: correo de otra cuenta de prueba de Mercado Pago (el comprador).
# El access token es el vendedor. No uses tu correo real ni el del mismo vendedor.
# En la pasarela hay que iniciar sesión con este COMPRADOR, nunca con el vendedor.
MERCADOPAGO_CORREO_PAGADOR_PRUEBA=

# --- Supabase CLI local: credenciales de Google OAuth (ver docs/autenticacion.md) ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
